# Postgres (Fly.io provides this automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/setplay

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here

# Base URL Better Auth uses to build email links (verify, password reset) and OAuth callbacks.
# IMPORTANT: in dev this MUST point to the Vite frontend (5173), NOT the backend (3000),
# so emailed links land on the React app after the backend's redirect.
# Vite proxies /api → backend automatically, so auth requests still work.
#   Dev:  http://localhost:5173
#   Prod: https://basketballtacticboard.com
BETTER_AUTH_URL=https://basketballtacticboard.com

# Comma-separated list of origins allowed to call the auth API.
# Prod: https://basketballtacticboard.com  |  Dev: http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173,https://basketballtacticboard.com

# Resend — https://resend.com. Leave RESEND_API_KEY blank in local dev to log mails to console.
RESEND_API_KEY=
# Verified sender. basketballtacticboard.com is verified in Resend (SPF/DKIM/MX live on Cloudflare).
EMAIL_FROM="Basketball Tactic Board <noreply@basketballtacticboard.com>"

# Google OAuth — https://console.cloud.google.com
# Leave blank to hide the Google button on the login page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
