# Postgres (Fly.io provides this automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/setplay

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here

# Your deployed URL (used for OAuth callbacks)
BETTER_AUTH_URL=https://your-app.fly.dev

# Comma-separated list of origins allowed to call the auth API. Add your prod domain here.
TRUSTED_ORIGINS=http://localhost:5173

# Resend — https://resend.com. Leave RESEND_API_KEY blank in local dev to log mails to console.
RESEND_API_KEY=
# Verified sender. Use the resend.dev sandbox while you set up your domain.
EMAIL_FROM="SetPlay <onboarding@resend.dev>"

# Google OAuth — https://console.cloud.google.com
# Leave blank to hide the Google button on the login page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
